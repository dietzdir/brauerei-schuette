rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Fields: id, name, category, variants, description, ingredients,
    //         alcohol, color, flavorProfile, depositInfo, image,
    //         isAiGenerated, badge, isActive, createdAt, updatedAt
    //
    // Collection: rentals
    // Fields: id, name, description, image, isAiGenerated,
    //         rentalPriceCents, depositCents, totalStock, isActive,
    //         createdAt, updatedAt
    //
    // Collection: users
    // Fields: uid, customerType, companyName, displayName, photoURL,
    //         email, phoneNumber, street, houseNumber, zipCode,
    //         city, isAnonymous, createdAt, lastOrderAt, updatedAt, role
    //
    // Collection: adminNotes
    // Fields: uid, notes, updatedAt
    //
    // Collection: orders
    // Fields: id, userId, customerName, customerEmail, customerPhone,
    //         street, houseNumber, zipCode, city, customerType,
    //         companyName, pickupDate, pickupTime, status, createdAt,
    //         items, rentalItems, itemsTotalCents, depositTotalCents, grandTotalCents
    //
    // Collection: settings / storeSettings
    // Fields: regularDayOfWeek, regularOpenTime, regularCloseTime, exceptions,
    //         bannerNotice, bannerLookaheadDays, updatedAt
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Validate allowed keys for users collection
    function isValidUserFields() {
      return request.resource.data.keys().hasOnly([
        'uid', 'customerType', 'companyName', 'displayName', 'photoURL',
        'email', 'phoneNumber', 'street', 'houseNumber', 'zipCode',
        'city', 'isAnonymous', 'createdAt', 'lastOrderAt', 'updatedAt', 'role'
      ]);
    }

    // Helper: Validate user document data types and constraints
    function isValidUserDoc(userId) {
      return isValidUserFields()
        && request.resource.data.uid == userId
        && (!('customerType' in request.resource.data) || request.resource.data.customerType in ['private', 'business'])
        && (!('isAnonymous' in request.resource.data) || request.resource.data.isAnonymous is bool)
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
        && (!('phoneNumber' in request.resource.data) || (request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 50))
        && (!('companyName' in request.resource.data) || (request.resource.data.companyName is string && request.resource.data.companyName.size() <= 150))
        && (!('street' in request.resource.data) || (request.resource.data.street is string && request.resource.data.street.size() <= 150))
        && (!('houseNumber' in request.resource.data) || (request.resource.data.houseNumber is string && request.resource.data.houseNumber.size() <= 20))
        && (!('zipCode' in request.resource.data) || (request.resource.data.zipCode is string && request.resource.data.zipCode.size() <= 20))
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 100))
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 1000));
    }

    // Helper: Validate allowed keys for orders collection
    function isValidOrderFields() {
      return request.resource.data.keys().hasOnly([
        'id', 'userId', 'customerName', 'customerEmail', 'customerPhone',
        'street', 'houseNumber', 'zipCode', 'city', 'customerType',
        'companyName', 'pickupDate', 'pickupTime', 'status', 'createdAt',
        'items', 'rentalItems', 'itemsTotalCents', 'depositTotalCents', 'grandTotalCents'
      ]);
    }

    // Products: Public read, Admin create/update with key whitelist, Admin delete
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly([
        'id', 'name', 'category', 'variants', 'description', 'ingredients',
        'alcohol', 'color', 'flavorProfile', 'depositInfo', 'image',
        'isAiGenerated', 'badge', 'isActive', 'createdAt', 'updatedAt'
      ]);
      allow delete: if isAdmin();
    }

    // Rentals / Equipment: Public read, Admin create/update with key whitelist, Admin delete
    match /rentals/{rentalId} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly([
        'id', 'name', 'description', 'image', 'isAiGenerated',
        'rentalPriceCents', 'depositCents', 'totalStock', 'isActive',
        'createdAt', 'updatedAt'
      ]);
      allow delete: if isAdmin();
    }

    // Users: Owner read/write with strict field whitelist & type validation, Admin read/delete
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) 
        && isValidUserDoc(userId)
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin');
        
      allow update: if (
        isOwner(userId)
        && isValidUserDoc(userId)
        && (!('role' in request.resource.data) || (resource.data != null && 'role' in resource.data && request.resource.data.role == resource.data.role))
      ) || isAdmin();
      
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Admin Notes: Separate collection, admin-only read/write with key whitelist
    // Ensures customer-facing clients can never see internal admin notes
    match /adminNotes/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['uid', 'notes', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Orders: Server-side creation only (via Admin SDK), Customer/Admin read, Admin status update
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email) ||
        isAdmin()
      );
      
      allow create: if false;
      allow update: if isAdmin() && isValidOrderFields();
      allow delete: if false;
    }

    // Settings & StoreSettings (e.g. store opening hours, exception windows)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly([
        'regularDayOfWeek', 'regularOpenTime', 'regularCloseTime', 'exceptions',
        'bannerNotice', 'bannerLookaheadDays', 'updatedAt'
      ]);
      allow delete: if isAdmin();
    }

    match /storeSettings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly([
        'regularDayOfWeek', 'regularOpenTime', 'regularCloseTime', 'exceptions',
        'bannerNotice', 'bannerLookaheadDays', 'updatedAt'
      ]);
      allow delete: if isAdmin();
    }
  }
}
